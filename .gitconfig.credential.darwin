[credential]
	helper = !/opt/homebrew/bin/gh auth git-credential
# fetch は HTTPS、push だけ SSH にする。GitHub の SSH は東京のエッジから遠隔バックエンドへ
# 中継され、OpenSSH のチャネルウィンドウ 2MB と往復 170ms の制約で転送が 11MB/s 程度で
# 頭打ちになる。HTTPS なら同じ回線で 29MB/s 出る。認証は上の gh の credential helper に任せる
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[pack]
	# index-pack の既定スレッド数は「コア数 / 2」(SMT 前提) なので、SMT のない
	# Apple Silicon では半分のコアが遊ぶ。全コアを使うと delta 解決が約 3 割速い
	threads = 8
