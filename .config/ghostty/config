# https://ghostty.org/docs/config
# OS 固有の設定は linux / darwin に置き、setup.sh が張る os の symlink 経由で末尾から読み込む

shell-integration = fish

font-family = ""
# font-family = "UDEV Gothic NF"
font-family = "UDEV Gothic 35NF"
# font-family = "Moralerspace Argon HWNF"
# font-family = "Moralerspace Krypton HWNF"
# font-family = "Moralerspace Neon HWNF"
# font-family = "Moralerspace Radon HWNF"
# font-size は OS ごとに linux / darwin で設定する

# リガチャを無効にする
font-feature = -calt
font-feature = -liga
font-feature = -dlig

window-padding-x = 8
window-padding-y = 8

# theme = Catppuccin Mocha
theme = TokyoNight Night

# カーソルを見やすくする
cursor-opacity = 0.8
cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
# 標準のマウススクロールが遅いので早くする
mouse-scroll-multiplier = 4

copy-on-select = true

# super + "+" (行末コメントは値の一部として読まれるため、コメントは必ず別行に書く)
keybind = super+shift+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

config-file = ?os
