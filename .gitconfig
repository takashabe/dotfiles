[include]
  path = ~/dotfiles/.config/git/catpuccin.gitconfig

[user]
  email = i@takashabe.dev
  name = takashabe
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMX/GvslRir6E5g8QOWL478p2odkSGtj32D9ISvJP+BQ
[color]
  ui = true
[core]
  quotepath = false
  excludesfile = ~/.gitignore
  pager = delta
  fsmonitor = false # 不安定なので停止する(daemon terminatedが頻出)
  untrackedcache = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true
  true-color = auto
  features = catpuccin-mocha
[merge]
  tool = vimdiff
[diff]
  tool = vimdiff
[ghq]
  root = ~/dev/src
[url "git@github.com:"]
  insteadOf = https://github.com/
[include]
  path = ~/.gitconfig.credential
[pull]
  rebase = false
[gpg]
  format = ssh
[commit]
  gpgsign = true
[scalar]
  repo = /Users/takashabe/dev/src/github.com/CastingONE/castingone
  repo = /Users/takashabe/dev/src/github.com/CastingONE/review-castingone
  repo = /Users/takashabe/dev/src/github.com/CastingONE/casone-lite-web-nextjs
  repo = /Users/takashabe/dev/src/github.com/qmk/qmk_firmware
  repo = /Users/takashabe/dev/src/github.com/takashabe/qmk_firmware
[maintenance]
  repo = /Users/takashabe/dev/src/github.com/CastingONE/casone-lite-web-nextjs
  repo = /Users/takashabe/dev/src/github.com/qmk/qmk_firmware
  repo = /Users/takashabe/dev/src/github.com/takashabe/qmk_firmware
[wt]
  basedir = ../.worktrees/{gitroot}
  copy = .envrc
  copy = compose.override.yaml
  copy = .env.local
  copy = .env.default.local
  copy = CLAUDE.local.md
  copy = .plans/
